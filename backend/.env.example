# Copy to backend/.env (done for you by `make env`). Never commit backend/.env.

# Local MongoDB (started with `make mongo`)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=geobeats_dev

# Browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Where the browser lands after Spotify login
FRONTEND_URL=http://127.0.0.1:3000

# Spotify: create an app at https://developer.spotify.com/dashboard
# and add this exact redirect URI to it (Spotify requires 127.0.0.1, not "localhost", for http):
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8001/api/auth/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google Maps JavaScript API key. Restrict it to these referrers:
#   http://127.0.0.1:3000/*   http://localhost:3000/*
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
