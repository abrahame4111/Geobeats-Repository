# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# React Native 0.72.6 refers to a retired JFrog Boost mirror. That mirror now
# returns an archive with a different checksum, which prevents `pod install`.
# Use Boost's official archive host; it serves the checksum already pinned by
# the React Native podspec. This patch runs after every `npm ci`, so the fix is
# reproducible and no generated dependency files need to be committed.
boost_podspec = File.join(
  __dir__, '..', 'node_modules', 'react-native', 'third-party-podspecs', 'boost.podspec'
)
legacy_boost_url = 'https://boostorg.jfrog.io/artifactory/main/release/1.76.0/source/boost_1_76_0.tar.bz2'
official_boost_url = 'https://archives.boost.io/release/1.76.0/source/boost_1_76_0.tar.bz2'

if File.exist?(boost_podspec)
  contents = File.read(boost_podspec)
  if contents.include?(legacy_boost_url)
    File.write(boost_podspec, contents.sub(legacy_boost_url, official_boost_url))
  end
end

# React Native 0.72's bundled Yoga uses a C++ literal-operator spelling that
# Xcode 27 promotes to an error. The no-space spelling is equivalent C++ and
# accepted by both the old and current compiler.
yoga_value_header = File.join(
  __dir__, '..', 'node_modules', 'react-native', 'ReactCommon', 'yoga', 'yoga', 'YGValue.h'
)

if File.exist?(yoga_value_header)
  contents = File.read(yoga_value_header)
  patched_contents = contents.gsub('operator"" _pt', 'operator""_pt')
                            .gsub('operator"" _percent', 'operator""_percent')
  File.write(yoga_value_header, patched_contents) if patched_contents != contents
end

# Xcode 27 no longer supports simulator targets below iOS 15.
platform :ios, '15.0'
prepare_react_native_project!

# If you are using a `react-native-flipper` your iOS build will fail when `NO_FLIPPER=1` is set.
# because `react-native-flipper` depends on (FlipperKit,...) that will be excluded
#
# To fix this you can also exclude `react-native-flipper` using a `react-native.config.js`
# ```js
# module.exports = {
#   dependencies: {
#     ...(process.env.NO_FLIPPER ? { 'react-native-flipper': { platforms: { ios: null } } } : {}),
# ```
# Flipper is an optional React Native debugging tool. Its legacy 0.182 build
# does not compile on Xcode 27 and is not required to run the application.
flipper_config = FlipperConfiguration.disabled

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MusicNavigatorFinal' do
  config = use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => config[:reactNativePath],
    # Hermes is now enabled by default. Disable by setting this flag to false.
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled],
    # Enables Flipper.
    #
    # Note that if you have use_frameworks! enabled, Flipper will not work and
    # you should disable the next line.
    :flipper_configuration => flipper_config,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'MusicNavigatorFinalTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    __apply_Xcode_12_5_M1_post_install_workaround(installer)

    # Some React Native 0.72 Pods retain their legacy (iOS 11/12) target even
    # when the application target is newer. Xcode 27 rejects those targets.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
