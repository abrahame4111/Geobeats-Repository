# Copy to frontend/.env (git-ignored). Expo inlines EXPO_PUBLIC_* at bundle time.

# Backend API + WebSocket. Android emulator: run `adb reverse tcp:8001 tcp:8001`
# so 127.0.0.1 on the emulator reaches your machine.
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8001

# Google Maps key (restrict to your app package/SHA-1)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional, only if the Mapbox view is used
EXPO_PUBLIC_MAPBOX_TOKEN=
